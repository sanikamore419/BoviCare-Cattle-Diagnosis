APP_NAME=BoviCare AI API
ENVIRONMENT=development
# Public doctor registration is available only in development/test environments.
DATABASE_URL=sqlite:///./bovicare.db
SECRET_KEY=change-this-to-a-long-random-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
FRONTEND_ORIGINS=http://localhost:5173
UPLOAD_DIR=./private_uploads
MAX_IMAGE_SIZE=10485760
NOTIFICATION_PROVIDER=mock
# Configure provider credentials only through environment variables when enabled.
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_SMS_API_KEY=
