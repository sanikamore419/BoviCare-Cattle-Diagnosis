# Copy to .env and replace the placeholders. Use the same hostname for the
# frontend and API (for example, localhost for both) during local development.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./bovicare.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=bovicare_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
FRONTEND_ORIGINS=http://localhost:5173
UPLOAD_DIR=./private_uploads
MAX_IMAGE_SIZE=10485760
NOTIFICATION_PROVIDER=mock
